# Copy to .env and fill in. .env must never be committed.

# --- AWS / Amazon Bedrock (Module 3) ---
AWS_PROFILE=bedrock-playground
AWS_REGION=eu-west-1
# EU inference profile ids, read from your own account with:
#   aws bedrock list-inference-profiles --region eu-west-1
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_MAIN=

# --- Langfuse (Module 5) ---
# EU cloud region: https://cloud.langfuse.com — self-hosted: http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Application ---
APP_ENVIRONMENT=local
RUST_LOG=info
