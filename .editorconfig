# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json,jsonl}]
indent_size = 2

# In Markdown, two trailing spaces mean "line break", so they must not be stripped.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[Makefile]
indent_style = tab
